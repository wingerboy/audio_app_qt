# Python字节码文件
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyo
*.pyd

# 虚拟环境
venv/
env/
ENV/
.env
.venv

# 发布和打包文件
dist/
build/
*.egg-info/
*.egg

# IDE配置文件
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 日志文件
*.log
logs/

# 缓存目录
.cache/
.pytest_cache/

# 媒体文件（避免大型音视频文件进入仓库）
*.mp3
*.wav
*.mp4
*.avi
*.mov
*.flac
*.ogg
*.m4a

# Whisper模型缓存
/models/
/.models/
**/models--*/

# 其他临时文件
temp/
tmp/
.tmp/

# 用户生成的输出文件
exports/
output/

# 配置文件（可能包含密钥）
config.ini
secrets.json
.env.local

# Jupyter Notebook
.ipynb_checkpoints
